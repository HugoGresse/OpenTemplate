{
  "name": "opentemplate",
  "version": "0.1.0",
  "description": "Image/PDF generation API from HTML+CSS templates. Satori primary, Puppeteer fallback.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "copy:monaco": "node scripts/copy-monaco.mjs",
    "postinstall": "node scripts/copy-monaco.mjs"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.4",
    "@fastify/swagger": "^9.8.1",
    "@resvg/resvg-js": "^2.6.2",
    "@scalar/fastify-api-reference": "^1.69.0",
    "async-mutex": "^0.5.0",
    "cheerio": "^1.2.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.5",
    "fastify-plugin": "^6.0.0",
    "juice": "^12.1.3",
    "monaco-editor": "^0.56.0",
    "mustache": "^4.2.0",
    "nanoid": "^6.0.1",
    "puppeteer": "25.11.0",
    "satori": "^0.33.4",
    "satori-html": "^0.3.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/mustache": "^4.2.5",
    "@types/node": "^26.6.1",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^10.10.0",
    "eslint-plugin-security": "^4.0.1",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
